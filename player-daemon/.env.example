# URL del sitio (sin barra final)
PLAYER_API_URL=http://localhost:4321

# El mismo valor que PLAYER_TOKEN en el .env.local del sitio
PLAYER_TOKEN=cambie-este-token

# Carpeta donde se guardan los audios descargados
AUDIO_DIR=./audios_cache

# Base de datos local de la cola
DB_PATH=./data/player.db

# Cada cuántos segundos consultar el servidor
POLL_SECONDS=120

# Comando para reproducir el mp3. Use {file} como marcador.
# Windows con ffmpeg instalado:
PLAY_CMD=ffplay -nodisp -autoexit -loglevel quiet {file}
# Windows con VLC:
# PLAY_CMD=C:\Program Files\VideoLAN\VLC\vlc.exe --play-and-exit --intf dummy {file}
# Linux:
# PLAY_CMD=mpg123 -q {file}

# 1 = no reproduce audio, solo simula (para probar en un PC sin parlantes)
DRY_RUN=0
