---
import { actions } from 'astro:actions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSettings } from '../../lib/settings';
import { getProfile } from '../../lib/profiles';
import { verifySession, sessionCookie } from '../../lib/session';
import { friendlyError } from '../../lib/errors';

const settings = await getSettings();
const queryError = Astro.url.searchParams.get('error') ?? '';

const result = Astro.getActionResult(actions.clientRegister);
if (result?.data?.ok) return Astro.redirect('/cuenta');

const existing = verifySession(Astro.cookies.get(sessionCookie.name)?.value);
if (existing) {
  const profile = await getProfile(existing.userId);
  if (profile) return Astro.redirect('/cuenta');
}
---

<BaseLayout title="Crear mi cuenta">
  <header class="top">
    <a class="logo" href="/" aria-label="La Gruta, inicio">
      <i class="ph ph-church" aria-hidden="true"></i>
    </a>
    <div class="brand">
      <b>La Gruta</b>
      <span>Crear cuenta</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/" style="margin-left:auto" aria-label="Volver al inicio">
      <i class="ph ph-arrow-left" aria-hidden="true"></i> <span>Volver al inicio</span>
    </a>
  </header>

  <div class="login-wrap">
    <div class="card pad login-card">
      <div class="login-head">
        <div class="logo"><i class="ph ph-user-plus" aria-hidden="true"></i></div>
        <h1>Crear mi cuenta</h1>
        <p class="muted">Solo necesitamos unos datos básicos para guardar sus pedidos.</p>
      </div>

      {(queryError || result?.error) && (
        <div class="alert danger">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>{queryError || friendlyError(result?.error)}</span>
        </div>
      )}

      <form method="POST" action={actions.clientRegister} class="stack">
        <div class="fields">
          <div class="field">
            <label for="reg-name">Su nombre</label>
            <input id="reg-name" type="text" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="reg-phone">Su teléfono</label>
            <input id="reg-phone" type="tel" name="phone" inputmode="tel" autocomplete="tel" required />
          </div>
          <div class="field full">
            <label for="reg-email">Correo electrónico</label>
            <input id="reg-email" type="email" name="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="reg-password">Contraseña</label>
            <input id="reg-password" type="password" name="password" autocomplete="new-password" minlength="8" required />
            <span class="hint">Mínimo 8 caracteres.</span>
          </div>
          <div class="field">
            <label for="reg-confirm">Repita la contraseña</label>
            <input id="reg-confirm" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required />
          </div>
        </div>
        <button class="btn btn-primary btn-block" type="submit">
          <i class="ph ph-user-plus" aria-hidden="true"></i> Crear cuenta
        </button>
      </form>

      <p class="read-time" style="text-align:center">
        ¿Ya tiene cuenta? <a href="/login">Entre aquí</a>.
      </p>
      <p class="read-time" style="text-align:center">
        ¿Necesita ayuda? Llame al {settings.help_phone}.
      </p>
    </div>
  </div>
</BaseLayout>
