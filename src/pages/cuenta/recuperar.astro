---
import { actions } from 'astro:actions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSettings } from '../../lib/settings';
import { getProfile } from '../../lib/profiles';
import { verifySession, sessionCookie } from '../../lib/session';
import { friendlyError } from '../../lib/errors';

const settings = await getSettings();
const result = Astro.getActionResult(actions.requestPasswordReset);
if (result?.data?.ok) {
  const params = new URLSearchParams({ email: result.data.email, enviado: '1' });
  return Astro.redirect(`/cuenta/restablecer?${params}`);
}

const existing = await verifySession(Astro.cookies.get(sessionCookie.name)?.value);
if (existing) {
  const profile = await getProfile(existing.userId);
  if (profile) return Astro.redirect(profile.role === 'ADMIN' ? '/panel' : '/cuenta');
}
---

<BaseLayout title="Recuperar contraseña" noindex>
  <header class="top">
    <a class="logo" href="/" aria-label="La Gruta, inicio">
      <i class="ph ph-church" aria-hidden="true"></i>
    </a>
    <div class="brand">
      <b>La Gruta</b>
      <span>Recuperar contraseña</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/login" style="margin-left:auto">
      <i class="ph ph-arrow-left" aria-hidden="true"></i> <span>Volver a entrar</span>
    </a>
  </header>

  <div class="login-wrap">
    <div class="card pad login-card">
      <div class="login-head">
        <div class="logo"><i class="ph ph-key" aria-hidden="true"></i></div>
        <h1>Recuperar contraseña</h1>
        <p class="muted">Escriba su correo y le enviaremos un código para cambiarla.</p>
      </div>

      {result?.error && (
        <div class="alert danger">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>{friendlyError(result.error)}</span>
        </div>
      )}

      <form method="POST" action={actions.requestPasswordReset} class="stack">
        <div class="field">
          <label for="reset-email">Correo electrónico</label>
          <input
            id="reset-email"
            type="email"
            name="email"
            autocomplete="email"
            maxlength="254"
            required
          />
        </div>
        <button class="btn btn-primary btn-block" type="submit">
          <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i> Enviar código
        </button>
      </form>

      <p class="read-time" style="text-align:center">
        Si el correo está registrado, recibirá un código. ¿Necesita ayuda? Llame al {settings.help_phone}.
      </p>
    </div>
  </div>
</BaseLayout>
