# La Gruta · variables del servidor (copie a .env.local y complete)
INSFORGE_URL=https://su-appkey.us-east.insforge.app
INSFORGE_API_KEY=
INSFORGE_ANON_KEY=

# Firma de la cookie de sesión (genere 32 bytes aleatorios en hexadecimal)
SESSION_SECRET=

# Correo por defecto de los scripts create-admin / promote-admin.
# Los permisos reales viven en la tabla public.profiles (ADMIN o CLIENT).
ADMIN_EMAIL=

# Token del reproductor local. Debe coincidir con PLAYER_TOKEN del player-daemon/.env
PLAYER_TOKEN=

# Opcional: IA para redactar y leer comprobantes. Sin clave, todo va a revisión manual.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
PUBLIC_SITE_URL=http://localhost:4321

# Desfase horario de La Gruta (Ecuador, UTC-5)
UTC_OFFSET_MIN=-300
