---
import { actions } from 'astro:actions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OtpInput from '../../components/OtpInput.astro';
import { getSettings } from '../../lib/settings';
import { getProfile } from '../../lib/profiles';
import { verifySession, sessionCookie } from '../../lib/session';
import { friendlyError } from '../../lib/errors';

const settings = await getSettings();
const queryEmail = (Astro.url.searchParams.get('email') ?? '').trim().toLowerCase();
const cookieEmail = Astro.cookies.get('gruta_verify_email')?.value ?? '';
const email = queryEmail || cookieEmail;
if (!email) return Astro.redirect('/login');
if (queryEmail) {
  Astro.cookies.set('gruta_verify_email', email, {
    httpOnly: true,
    sameSite: 'lax',
    secure: import.meta.env.PROD,
    path: '/',
    maxAge: 900,
  });
}
const mailFailed = Astro.url.searchParams.get('fallo') === '1';
const warned = Astro.url.searchParams.get('aviso') === '1';

const verify = Astro.getActionResult(actions.verifyEmail);
if (verify?.data?.ok) return Astro.redirect(verify.data.isAdmin ? '/panel' : '/cuenta');

const resend = Astro.getActionResult(actions.resendVerification);
const errorText = friendlyError(verify?.error) || friendlyError(resend?.error);

const existing = await verifySession(Astro.cookies.get(sessionCookie.name)?.value);
if (existing) {
  const profile = await getProfile(existing.userId);
  if (profile) return Astro.redirect(profile.role === 'ADMIN' ? '/panel' : '/cuenta');
}
---

<BaseLayout title="Verificar correo" noindex>
  <header class="top">
    <a class="logo" href="/" aria-label="La Gruta, inicio">
      <i class="ph ph-church" aria-hidden="true"></i>
    </a>
    <div class="brand">
      <b>La Gruta</b>
      <span>Verificar correo</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/login" style="margin-left:auto">
      <i class="ph ph-arrow-left" aria-hidden="true"></i> <span>Volver a entrar</span>
    </a>
  </header>

  <div class="login-wrap">
    <div class="card pad login-card">
      <div class="login-head">
        <div class="logo"><i class="ph ph-envelope-simple" aria-hidden="true"></i></div>
        <h1>Confirme su correo</h1>
        <p class="muted">Escriba el código de 6 dígitos que enviamos a su correo.</p>
      </div>

      {mailFailed && (
        <div class="alert warn">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>La cuenta se creó, pero no pudimos enviar el primer código. Use “Enviar código de nuevo”.</span>
        </div>
      )}

      {warned && !errorText && !resend?.data?.ok && (
        <div class="alert warn">
          <i class="ph ph-envelope-simple" aria-hidden="true"></i>
          <span>Confirme su correo para entrar. Use el código enviado o pida uno nuevo.</span>
        </div>
      )}

      {resend?.data?.ok && (
        <div class="alert ok">
          <i class="ph ph-check-circle" aria-hidden="true"></i>
          <span>Si el correo está registrado, enviamos un código nuevo.</span>
        </div>
      )}

      {errorText && (
        <div class="alert danger">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>{errorText}</span>
        </div>
      )}

      <form method="POST" action={actions.verifyEmail} class="stack">
        <div class="field">
          <span class="label">Correo electrónico</span>
          <div class="locked-field">
            <i class="ph ph-lock-simple" aria-hidden="true"></i>
            <span>{email}</span>
          </div>
          <input type="hidden" name="email" value={email} />
          <span class="hint">Para usar otro correo, vuelva a entrar o solicite un código nuevo.</span>
        </div>
        <OtpInput id="verify" />
        <button class="btn btn-primary btn-block" type="submit">
          <i class="ph ph-check" aria-hidden="true"></i> Confirmar correo
        </button>
      </form>

      <form method="POST" action={actions.resendVerification} class="stack" style="margin-top:16px">
        <input type="hidden" name="email" value={email} />
        <button class="btn btn-ghost btn-block" type="submit">
          <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i> Enviar código de nuevo
        </button>
      </form>

      <p class="read-time" style="text-align:center">
        ¿Necesita ayuda? Llame al {settings.help_phone}.
      </p>
    </div>
  </div>
</BaseLayout>
