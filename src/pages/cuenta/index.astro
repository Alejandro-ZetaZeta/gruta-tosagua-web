---
import { actions } from 'astro:actions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getSettings } from '../../lib/settings';
import { verifySession, sessionCookie } from '../../lib/session';
import { getProfile } from '../../lib/profiles';
import { getOrdersForUser } from '../../lib/services/orders';
import { CATEGORY_META, STATUS_META } from '../../lib/types';
import { formatDateLong, formatMoney } from '../../lib/time';
import { friendlyError } from '../../lib/errors';

const settings = await getSettings();
const session = await verifySession(Astro.cookies.get(sessionCookie.name)?.value);
if (!session) return Astro.redirect('/cuenta/login');

const profile = await getProfile(session.userId);
if (!profile) {
  return Astro.redirect(
    `/cuenta/login?error=${encodeURIComponent('Su cuenta no tiene perfil. Comuníquese con la encargada.')}`,
  );
}

const result = Astro.getActionResult(actions.updateProfile);
if (result?.data?.ok) return Astro.redirect('/cuenta?guardado=1', 303);

const orders = await getOrdersForUser(session.userId);
const name = profile.display_name ?? session.email;
const saved = Astro.url.searchParams.get('guardado') === '1';
const editing = Astro.url.searchParams.get('editar') === '1' || Boolean(result?.error);
const missing = [
  profile.display_name?.trim() ? '' : 'nombre',
  profile.phone ? '' : 'teléfono',
].filter(Boolean);
---

<BaseLayout title="Mi cuenta">
  <Header helpPhone={settings.help_phone} showLogout />

  <div class="dashboard">
    <section class="card pad dash-head">
      <div>
        <span class="eyebrow">Mi cuenta</span>
        <h1>Hola, {name}</h1>
        <p class="muted">{session.email}{profile.phone ? ` · ${profile.phone}` : ''}</p>
      </div>
      <div class="row">
        <a class="btn btn-primary" href="/cuenta/nuevo">
          <i class="ph ph-plus" aria-hidden="true"></i> Pedir un anuncio
        </a>
        {profile.role === 'ADMIN' && (
          <a class="btn btn-ghost" href="/panel">
            <i class="ph ph-gear-six" aria-hidden="true"></i> Ir al panel
          </a>
        )}
      </div>
    </section>

    {saved && (
      <div class="alert ok" data-autodismiss>
        <i class="ph ph-check-circle" aria-hidden="true"></i>
        <span>Sus datos se guardaron.</span>
      </div>
    )}

    {profile.role !== 'ADMIN' && missing.length > 0 && !saved && (
      <div class="alert warn">
        <i class="ph ph-user-circle" aria-hidden="true"></i>
        <span>
          Complete su cuenta: falta {missing.join(' y ')}.{' '}
          <a href="/cuenta?editar=1#mis-datos">Complete sus datos</a> para que podamos comunicarnos con usted.
        </span>
      </div>
    )}

    {result?.error && (
      <div class="alert danger">
        <i class="ph ph-warning" aria-hidden="true"></i>
        <span>{friendlyError(result.error)}</span>
      </div>
    )}

    <div class="card pad stack" id="mis-datos">
      <div class="adm-head">
        <h2 style="font-size:1.35rem">Sus datos</h2>
        {!editing && (
          <a class="btn btn-ghost btn-sm" href="/cuenta?editar=1#mis-datos">
            <i class="ph ph-pencil-simple" aria-hidden="true"></i> Editar datos
          </a>
        )}
      </div>

      {editing ? (
        <form method="POST" action={actions.updateProfile} class="stack">
          <div class="fields">
            <div class="field">
              <label for="profile-name">Nombre o usuario</label>
              <input
                id="profile-name"
                type="text"
                name="name"
                autocomplete="name"
                minlength="2"
                maxlength="80"
                value={profile.display_name ?? ''}
                required
              />
              <span class="hint">Puede usar el nombre de Google o cambiarlo.</span>
            </div>
            <div class="field">
              <label for="profile-phone">Teléfono</label>
              <input
                id="profile-phone"
                type="tel"
                name="phone"
                inputmode="tel"
                autocomplete="tel"
                maxlength="20"
                value={profile.phone ?? ''}
                required
              />
              <span class="hint">Ej.: 0991234567. Sin código de país.</span>
            </div>
          </div>
          <div class="row">
            <button class="btn btn-primary" type="submit">
              <i class="ph ph-check" aria-hidden="true"></i> Guardar datos
            </button>
            <a class="btn btn-ghost" href="/cuenta#mis-datos">Cancelar</a>
          </div>
        </form>
      ) : (
        <>
          <dl class="bank">
            <div><dt>Nombre o usuario</dt><dd>{name}</dd></div>
            <div><dt>Correo</dt><dd>{session.email}</dd></div>
            <div><dt>Teléfono</dt><dd>{profile.phone ?? '—'}</dd></div>
          </dl>
          <p class="read-time">Para cambiar el correo, llame a la encargada.</p>
        </>
      )}
    </div>

    <div class="card pad stack">
      <div class="adm-head">
        <h2 style="font-size:1.5rem">Mis pedidos</h2>
        <a href="/seguimiento">Consultar otro pedido</a>
      </div>

      {orders.length === 0 ? (
        <p class="empty">
          Todavía no pidió ningún anuncio.
          <a href="/cuenta/nuevo">Pida el primero aquí</a>.
        </p>
      ) : (
        <div class="records">
          {orders.map((order) => (
            <div class="record">
              <div class="grow">
                <b>{order.order_code} · {CATEGORY_META[order.category].short}</b>
                <div class="sub">
                  {formatDateLong(order.target_date)} · {order.total_emissions}{' '}
                  {order.total_emissions === 1 ? 'vez' : 'veces'} · {formatMoney(Number(order.amount_due))}
                </div>
              </div>
              <span class={`pill ${STATUS_META[order.status].pill}`}>
                <i class={`ph ph-${STATUS_META[order.status].icon}`} aria-hidden="true"></i>
                {STATUS_META[order.status].label}
              </span>
              <a class="btn btn-ghost btn-sm" href={`/seguimiento?codigo=${encodeURIComponent(order.order_code)}`}>
                Ver
              </a>
            </div>
          ))}
        </div>
      )}
    </div>

    <p class="read-time" style="text-align:center">
      ¿Necesita ayuda? Llame a la encargada al <a href={`tel:${settings.help_phone.replace(/[^\d+]/g, '')}`}>{settings.help_phone}</a>.
    </p>
  </div>
</BaseLayout>
