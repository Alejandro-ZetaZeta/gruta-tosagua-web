---
interface Props {
  variant?: 'client' | 'admin';
  helpPhone?: string;
  subtitle?: string;
  homeHref?: string;
  showLogout?: boolean;
  children?: unknown;
}

const {
  variant = 'client',
  helpPhone,
  subtitle = variant === 'admin' ? 'Panel de la encargada' : 'Anuncios por megafonía',
  homeHref = variant === 'admin' ? '/panel' : '/',
  showLogout = false,
} = Astro.props;

const cleanPhone = (helpPhone ?? '').replace(/[^\d+]/g, '');
---

<header class="top">
  <a class="logo" href={homeHref} aria-label="La Gruta, inicio">
    <i class="ph ph-church" aria-hidden="true"></i>
  </a>
  <div class="brand">
    <b>La Gruta</b>
    <span>{subtitle}</span>
  </div>
  <slot name="right">
    <div class="top-actions">
      {helpPhone ? (
        <a
          class="btn btn-ghost btn-sm help"
          href={`tel:${cleanPhone}`}
          aria-label={helpPhone ? '¿Necesita ayuda? Llame a La Gruta' : 'Consultar un pedido'}
        >
          <i class="ph ph-phone" aria-hidden="true"></i><span>¿Necesita ayuda?</span>
        </a>
      ) : (
        <a class="btn btn-ghost btn-sm help" href="/seguimiento">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i><span>Consultar pedido</span>
        </a>
      )}
      {showLogout && (
        <form method="POST" action="/api/logout">
          <button class="btn btn-logout btn-sm" type="submit" aria-label="Cerrar sesión">
            <i class="ph ph-sign-out" aria-hidden="true"></i><span>Cerrar sesión</span>
          </button>
        </form>
      )}
    </div>
  </slot>
</header>
