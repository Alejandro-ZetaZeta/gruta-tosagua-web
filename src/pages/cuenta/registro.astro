---
import { actions } from 'astro:actions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSettings } from '../../lib/settings';
import { getProfile } from '../../lib/profiles';
import { verifySession, sessionCookie } from '../../lib/session';
import { friendlyError } from '../../lib/errors';

const settings = await getSettings();
const queryError = Astro.url.searchParams.get('error') ?? '';

const result = Astro.getActionResult(actions.clientRegister);
if (result?.data?.ok) return Astro.redirect('/cuenta');

const existing = verifySession(Astro.cookies.get(sessionCookie.name)?.value);
if (existing) {
  const profile = await getProfile(existing.userId);
  if (profile) return Astro.redirect('/cuenta');
}
---

<BaseLayout title="Crear mi cuenta">
  <header class="top">
    <a class="logo" href="/" aria-label="La Gruta, inicio">
      <i class="ph ph-church" aria-hidden="true"></i>
    </a>
    <div class="brand">
      <b>La Gruta</b>
      <span>Crear cuenta</span>
    </div>
    <a class="btn btn-ghost btn-sm" href="/" style="margin-left:auto" aria-label="Volver al inicio">
      <i class="ph ph-arrow-left" aria-hidden="true"></i> <span>Volver al inicio</span>
    </a>
  </header>

  <div class="login-wrap">
    <div class="card register-card">
      <div class="register-head">
        <div>
          <span class="eyebrow">Cuenta nueva</span>
          <h1>Crear mi cuenta</h1>
          <p class="muted">Solo necesitamos unos datos básicos para guardar sus pedidos.</p>
        </div>
        <a class="btn btn-google register-google" href="/api/auth/google">
          <img src="/images/google-g.png" alt="" width="20" height="20" aria-hidden="true" />
          Registrarme con Google
        </a>
      </div>

      {(queryError || result?.error) && (
        <div class="alert danger">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>{queryError || friendlyError(result?.error)}</span>
        </div>
      )}

      <div class="divider">o use su correo</div>

      <form method="POST" action={actions.clientRegister} class="stack">
        <div class="fields">
          <div class="field">
            <label for="reg-name">Su nombre</label>
            <input id="reg-name" type="text" name="name" autocomplete="name" required />
            <span class="hint">Como quiere que le llamemos.</span>
          </div>
          <div class="field">
            <label for="reg-phone">Su teléfono</label>
            <input id="reg-phone" type="tel" name="phone" inputmode="tel" autocomplete="tel" maxlength="20" required />
            <span class="hint">Ej.: 0991234567. Sin código de país.</span>
          </div>
          <div class="field full">
            <label for="reg-email">Correo electrónico</label>
            <input id="reg-email" type="email" name="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="field">
            <label for="reg-password">Contraseña</label>
            <div class="password-wrap">
              <input id="reg-password" type="password" name="password" autocomplete="new-password" minlength="12" required />
              <button type="button" class="toggle-password" data-target="reg-password" aria-label="Mostrar contraseña" aria-pressed="false">
                <i class="ph ph-eye" aria-hidden="true"></i>
              </button>
            </div>
            <span class="hint">Mínimo 12 caracteres, con mayúscula, minúscula, número y símbolo.</span>
          </div>
          <div class="field">
            <label for="reg-confirm">Repita la contraseña</label>
            <div class="password-wrap">
              <input id="reg-confirm" type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required />
              <button type="button" class="toggle-password" data-target="reg-confirm" aria-label="Mostrar contraseña" aria-pressed="false">
                <i class="ph ph-eye" aria-hidden="true"></i>
              </button>
            </div>
            <span class="hint">Debe ser igual a la anterior.</span>
          </div>
        </div>
        <div class="register-actions">
          <p class="read-time">Todos los campos son obligatorios.</p>
          <button class="btn btn-primary register-submit" type="submit">
            <i class="ph ph-user-plus" aria-hidden="true"></i> Crear cuenta
          </button>
        </div>
      </form>

      <div class="register-foot">
        <p class="read-time">¿Ya tiene cuenta? <a href="/login">Entre aquí</a>.</p>
        <p class="read-time">¿Necesita ayuda? Llame al {settings.help_phone}.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .password-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .password-wrap input {
    padding-right: 48px;
  }
  .toggle-password {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 10px;
    color: var(--color-muted, #6B6258);
    font-size: 1.35rem;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  .toggle-password:hover {
    color: var(--color-ink, #1F1633);
    background-color: rgba(0, 0, 0, 0.04);
  }
  .toggle-password:focus-visible {
    outline: 2px solid var(--color-primary, #3B1F7A);
    outline-offset: -2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.toggle-password').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;

      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(isPassword));
      btn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');

      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = isPassword ? 'ph ph-eye-slash' : 'ph ph-eye';
      }
    });
  });
</script>
