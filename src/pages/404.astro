---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <header class="top">
    <a class="logo" href="/" aria-label="La Gruta, inicio">
      <i class="ph ph-church" aria-hidden="true"></i>
    </a>
    <div class="brand"><b>La Gruta</b><span>Anuncios por megafonía</span></div>
  </header>

  <div class="narrow">
    <div class="card pad done-hero">
      <div class="seal" style="background:var(--color-gold-soft);color:var(--color-gold-ink)">
        <i class="ph ph-map-pin" aria-hidden="true"></i>
      </div>
      <h1>No encontramos esta página</h1>
      <p class="muted">Puede volver al inicio o consultar un pedido con su código y teléfono.</p>
      <div class="row" style="justify-content:center;margin-top:24px">
        <a class="btn btn-primary" href="/">Volver al inicio</a>
        <a class="btn btn-ghost" href="/seguimiento">Consultar mi pedido</a>
      </div>
    </div>
  </div>
</BaseLayout>
